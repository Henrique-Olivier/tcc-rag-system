# Copie para .env e preencha. O .env nunca é commitado.

# --- LLM (plano, seções 6 e 10) ---
# Chave da API do Groq (obrigatória).
GROQ_API_KEY=
# Modelo que gera as respostas.
LLM_ANSWER_MODEL=openai/gpt-oss-120b
# Modelo que reescreve perguntas e gera títulos.
LLM_REWRITE_MODEL=openai/gpt-oss-20b

# --- Embedding e busca ---
# Modelo de embedding (multilíngue, 1024 dimensões).
EMBEDDING_MODEL=BAAI/bge-m3
# Número de trechos recuperados por pergunta.
TOP_K=12
# Tamanho e sobreposição dos trechos, em tokens do bge-m3. Mudar exige reindexar (plano, seção 5.6).
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# Limiar de similaridade (1 - distância de cosseno). Calibrado na T26 (measurements.md).
MIN_SIMILARITY=0.5
# Trocas anteriores da conversa enviadas à LLM.
HISTORY_TURNS=3

# --- Ingestão ---
# Tentativas de processamento antes de marcar o documento como failed.
MAX_ATTEMPTS=3
# Tamanho máximo por arquivo enviado, em MB.
MAX_UPLOAD_MB=50
# Diretório dos PDFs dentro dos containers (volume `pdfs`).
DATA_DIR=/data/pdfs

# --- CPU (plano, seção 11) ---
# Threads do PyTorch em cada processo; também definem OMP/MKL_NUM_THREADS no Compose.
API_TORCH_THREADS=2
WORKER_TORCH_THREADS=4

# --- Banco ---
# Credenciais do container Postgres.
POSTGRES_USER=rag
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rag
# Conexão usada por api, worker e migrate; mantenha igual às credenciais acima.
# Host `db` dentro do Compose; use 127.0.0.1 (não localhost, que no Windows tenta IPv6 e trava) para rodar fora do Docker.
DATABASE_URL=postgresql+psycopg://rag:troque-esta-senha@db:5432/rag

# --- Testes (opcional) ---
# Banco dos testes de integração; padrão: rag_test no mesmo Postgres, via 127.0.0.1.
# Nunca aponte para o banco da aplicação: os testes limpam as tabelas.
# TEST_DATABASE_URL=postgresql+psycopg://rag:troque-esta-senha@127.0.0.1:5432/rag_test
